# Copy to .env and adjust. Every value here has a working default.

# --- models ---------------------------------------------------------------
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# 0 = skip the LLM and answer extractively (fast, deterministic)
RAG_USE_LLM=1

# --- paths ----------------------------------------------------------------
RAG_DOCS_DIR=data/docs
RAG_INDEX_DIR=data/index
