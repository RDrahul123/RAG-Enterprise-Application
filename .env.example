# Copy to .env and adjust. Everything here has a working default.

# --- models ---------------------------------------------------------------
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# auto | extractive | local | hf_api
RAG_LLM_PROVIDER=auto
RAG_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Optional: enables the Hugging Face Inference API backend (free tier).
HF_TOKEN=

# --- retrieval ------------------------------------------------------------
RAG_CHUNK_TOKENS=320
RAG_CHUNK_OVERLAP=60
RAG_DENSE_TOP_K=24
RAG_BM25_TOP_K=24
RAG_RERANK_TOP_K=16
RAG_FINAL_TOP_K=6
RAG_MIN_RERANK_SCORE=-6.0

# --- generation -----------------------------------------------------------
RAG_MAX_NEW_TOKENS=512
# 0 = greedy decoding (deterministic); raise for more varied phrasing
RAG_TEMPERATURE=0.0

# --- paths ----------------------------------------------------------------
RAG_DATA_DIR=data/docs
RAG_INDEX_DIR=data/index
